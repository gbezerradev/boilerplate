  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@boilerplate/api": "*",
    "@boilerplate/auth": "*",
    "@boilerplate/billing": "*",
    "@boilerplate/db": "*",
    "@boilerplate/env": "*",
    "@hono/node-server": "^2.0.12",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "better-auth": "1.6.27",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boilerplate/config": "*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
