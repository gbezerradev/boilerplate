DATABASE_URL=postgresql://postgres:password@localhost:5432/boilerplate
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
EMAIL_PROVIDER=console
EMAIL_FROM=Boilerplate <noreply@example.com>
EMAIL_DELIVERY_MODE=inline
# Production only, with EMAIL_PROVIDER=resend:
# RESEND_API_KEY=re_...
BILLING_PROVIDER=disabled
# To enable Stripe billing:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# Comma-separated platform administrator email addresses:
ADMIN_EMAILS=
# Background worker tuning:
JOB_POLL_INTERVAL_MS=1000
JOB_BATCH_SIZE=10
STORAGE_PROVIDER=disabled
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3-compatible.example.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
ANALYTICS_PROVIDER=disabled
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
PORT=3000
NODE_ENV=development
